        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.linn22.bamboleapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2766c66c-c476-4bc3-9c85-9b668aec26ba"
      }
    },
    "plugins": [
      "expo-sqlite"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2766c66c-c476-4bc3-9c85-9b668aec26ba"
    }
  }
